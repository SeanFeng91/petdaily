generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PetProfile {
  id             String          @id @default(cuid())
  name           String
  breed          String
  sex            String
  birthday       DateTime
  avatarUrl      String?
  currentWeight  Float?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  timelineEvents TimelineEvent[]
  reminders      Reminder[]
  weightRecords  WeightRecord[]
  expenses       Expense[]
  photos         PhotoAsset[]
  insights       AiInsight[]
  barkSamples    BarkSample[]
  barkClusters   BarkCluster[]
  barkSessions   BarkSession[]
  barkModels      BarkModelArtifact[]
}

model TimelineEvent {
  id         String     @id @default(cuid())
  petId      String
  type       String
  title      String
  note       String?
  happenedAt DateTime
  amount     Float?
  unit       String?
  metadata   String     @default("{}")
  photoUrl   String?
  createdAt  DateTime   @default(now())
  pet        PetProfile @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, happenedAt])
  @@index([type])
}

model BarkCluster {
  id          String       @id @default(cuid())
  petId       String
  label       String?
  reason      String?
  status      String       @default("unlabeled")
  sampleCount Int          @default(0)
  centroid    String       @default("[]")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  pet         PetProfile   @relation(fields: [petId], references: [id], onDelete: Cascade)
  samples     BarkSample[]

  @@index([petId, status])
}

model BarkSession {
  id                     String       @id @default(cuid())
  petId                  String
  timelineEventId         String?
  representativeSampleId  String?
  startedAt              DateTime
  endedAt                DateTime
  sampleCount            Int          @default(0)
  barkCount              Int          @default(0)
  status                 String       @default("candidate")
  reason                 String?
  summary                String       @default("{}")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  pet                    PetProfile   @relation(fields: [petId], references: [id], onDelete: Cascade)
  samples                BarkSample[]

  @@index([petId, startedAt])
  @@index([status])
}

model BarkSample {
  id               String       @id @default(cuid())
  petId            String
  clusterId        String?
  sessionId        String?
  timelineEventId  String?
  audioUrl         String?
  audioObjectKey   String?
  audioContentType String?
  audioSizeBytes   Int?
  features         String       @default("{}")
  embedding        String       @default("[]")
  waveform         String       @default("[]")
  barkScore        Float        @default(0)
  detectorVersion  String
  status           String       @default("candidate")
  reason           String?
  note             String?
  capturedAt       DateTime
  durationMs       Int?
  createdAt        DateTime     @default(now())
  pet              PetProfile   @relation(fields: [petId], references: [id], onDelete: Cascade)
  cluster          BarkCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  session          BarkSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([petId, capturedAt])
  @@index([clusterId])
  @@index([sessionId])
  @@index([status])
}

model BarkModelArtifact {
  id        String     @id @default(cuid())
  petId     String
  version   String
  modelType String
  artifact  String     @default("{}")
  metrics   String     @default("{}")
  status    String     @default("active")
  trainedAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  pet       PetProfile @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, modelType, status])
  @@unique([petId, version, modelType])
}

model Reminder {
  id            String     @id @default(cuid())
  petId         String
  kind          String
  title         String
  scheduledTime String
  weekdays      String     @default("1,2,3,4,5,6,7")
  active        Boolean    @default(true)
  nextDueAt     DateTime?
  lastDoneAt    DateTime?
  lastSkippedAt DateTime?
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  pet           PetProfile @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, active])
}

model WeightRecord {
  id         String     @id @default(cuid())
  petId      String
  measuredAt DateTime
  weightKg   Float
  note       String?
  createdAt  DateTime   @default(now())
  pet        PetProfile @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, measuredAt])
}

model Expense {
  id          String     @id @default(cuid())
  petId       String
  category    String
  itemName    String
  amountCents Int
  purchasedAt DateTime
  note        String?
  createdAt   DateTime   @default(now())
  pet         PetProfile @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, purchasedAt])
  @@index([category])
}

model PhotoAsset {
  id            String     @id @default(cuid())
  petId         String
  url           String
  caption       String?
  takenAt       DateTime
  linkedEventId String?
  createdAt     DateTime   @default(now())
  pet           PetProfile @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, takenAt])
}

model AiInsight {
  id          String     @id @default(cuid())
  petId       String
  scope       String
  title       String
  body        String
  riskLevel   String     @default("info")
  generatedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  pet         PetProfile @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, generatedAt])
  @@index([scope])
}
