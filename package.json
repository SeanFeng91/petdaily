{
  "name": "petdaily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node scripts/db-push.mjs --reset && node prisma/seed.js",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:d1:create": "wrangler d1 create petdaily",
    "cf:d1:migrate:local": "wrangler d1 migrations apply petdaily --local",
    "cf:d1:migrate": "wrangler d1 migrations apply petdaily --remote",
    "cf:d1:seed:local": "wrangler d1 execute petdaily --local --file=cloudflare/seed.sql",
    "cf:d1:seed": "wrangler d1 execute petdaily --remote --file=cloudflare/seed.sql",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.12.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.15",
    "prisma": "^5.22.0",
    "wrangler": "^4.47.0"
  }
}
